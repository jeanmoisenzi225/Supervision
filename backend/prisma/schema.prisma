generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  /// Double authentification (code à 6 chiffres) : secret en attente tant
  /// que totpEnabled est faux, puis actif.
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  /// Dernier pas de temps accepté : un même code ne sert qu'une fois.
  totpLastStep Int?
}

/// Résultat d'une vérification de disponibilité (une adresse d'une appli).
model CheckResult {
  id         BigInt   @id @default(autoincrement())
  appKey     String
  checkId    String
  at         DateTime @default(now())
  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  error      String?

  @@index([appKey, checkId, at])
  @@index([at])
}

/// Relevé en direct de l'état d'un service (v0.29.0) : mémoire réelle, démarrage, retard de la boucle.
model RuntimeSample {
  id          BigInt   @id @default(autoincrement())
  appKey      String
  at          DateTime @default(now())
  ok          Boolean
  startedAt   DateTime?
  uptimeSec   Int?
  rssMb       Int?
  heapMb      Int?
  externalMb  Int?
  loopLagMaxMs Float?
  imports     Int?
  jobs        Int?
  error       String?

  @@index([appKey, at])
  @@index([at])
}

/// Alerte : panne détectée, erreur remontée par une appli ou alerte métier.
/// Une même alerte (même empreinte) ouverte n'est pas dupliquée : son
/// compteur augmente.
model Alert {
  id          String    @id @default(cuid())
  appKey      String
  kind        String // down | error | app
  severity    String // critical | warning | info
  title       String
  detail      String?
  fingerprint String
  status      String    @default("open") // open | acknowledged | resolved
  count       Int       @default(1)
  openedAt    DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  ackAt       DateTime?
  resolvedAt  DateTime?

  @@index([status, openedAt])
  @@index([appKey, fingerprint, status])
}

/// Journal envoyé par une appli.
model LogEntry {
  id        BigInt   @id @default(autoincrement())
  appKey    String
  at        DateTime
  receivedAt DateTime @default(now())
  level     String // debug | info | warn | error | fatal
  source    String? // backend | frontend | cron | ...
  message   String
  context   Json?
  requestId String?

  @@index([appKey, at])
  @@index([level, at])
  @@index([at])
}

/// Trace de chaque action super administrateur lancée depuis la supervision.
model ActionAudit {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  by      String
  appKey  String
  action  String
  params  Json?
  ok      Boolean
  message String?
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// Réglages générés par le serveur lui-même (ex. clés des notifications),
/// pour ne rien avoir à saisir à la main dans Render.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Supervision coupée sur une appli (maintenance) : plus de vérifications,
/// d'alertes ni de notifications ; les journaux continuent d'arriver.
model AppPause {
  appKey   String    @id
  until    DateTime?
  reason   String?
  by       String
  pausedAt DateTime  @default(now())
}

/// Mesure enregistrée par la Supervision elle-même (ex. taille d'une base),
/// pour avoir un historique quand Render ne le fournit pas (offre Hobby).
model ResourceSample {
  id    BigInt   @id @default(autoincrement())
  key   String // ex. "dbsize:dpg-xxx"
  at    DateTime @default(now())
  value Float

  @@index([key, at])
}

/// Tâche planifiée d'une appli (rappels, récap, purge…), déclarée par l'appli
/// elle-même à sa première exécution. Sert à détecter une tâche qui ne tourne
/// pas, échoue ou tourne deux fois.
model Job {
  id           String    @id @default(cuid())
  appKey       String
  key          String
  label        String
  /// Horaire attendu, expression cron à 5 champs en UTC.
  cron         String
  graceMinutes Int       @default(15)
  lastRunAt    DateTime?
  lastStatus   String? // ok | error
  lastMessage  String?
  createdAt    DateTime  @default(now())
  runs         JobRun[]

  @@unique([appKey, key])
}

model JobRun {
  id         BigInt   @id @default(autoincrement())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  status     String // ok | error
  message    String?
  durationMs Int?

  @@index([jobId, at])
}

/// Chantier d'un backlog (lu sur GitHub dans le dépôt de l'appli).
model BacklogItem {
  id              String    @id @default(cuid())
  source          String // mga, procedia, yiri, my-family, supervision
  key             String
  number          String?
  title           String
  status          String // done | in_progress | waiting | todo | dropped | info
  versions        String[]
  grp             String?
  priority        String?
  subtasks        Json
  body            String
  position        Int
  firstSeenAt     DateTime  @default(now())
  statusChangedAt DateTime  @default(now())
  /// Rubrique disparue du backlog (renumérotée ou supprimée).
  removedAt       DateTime?

  @@unique([source, key])
}

/// Changement de statut d'un chantier, constaté à la synchronisation.
model BacklogEvent {
  id     BigInt   @id @default(autoincrement())
  source String
  key    String
  title  String
  from   String?
  to     String
  at     DateTime @default(now())

  @@index([source, at])
}

/// Fiche client de facturation NJMDev.
model BillingClient {
  id             String   @id @default(cuid())
  kind           String   @default("company")
  name           String
  email          String?
  phone          String?
  billingAddress String?
  postalCode     String?
  city           String?
  country        String   @default("Côte d’Ivoire")
  rccm           String?
  ncc            String?
  vatNumber      String?
  notes          String?
  /// Applis dont l'hébergement est facturé à ce client (clés du catalogue : procedia, mga…), v0.19.0.
  appKeys        String[] @default([])
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoices       BillingInvoice[]
  serviceDocs    BillingServiceDoc[]
  @@index([name])
  @@index([archivedAt])
}

/// Brouillon de facture, sans numéro officiel avant émission.
model BillingInvoice {
  id          String              @id @default(cuid())
  number      String?             @unique
  status      String              @default("draft")
  clientId    String
  client      BillingClient       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  issueDate   DateTime?
  serviceDate DateTime?
  dueDate     DateTime?
  currency    String              @default("XOF")
  /// « forecast » : facture prévisionnelle (estimation avant la facture de Render) ; « draft » : brouillon de facture (v0.19.0).
  kind        String              @default("forecast")
  /// Mois concerné, « 2026-11 ».
  period      String?
  /// Taux utilisé pour convertir les coûts (dollars) dans la devise du document.
  usdRate     Decimal?            @db.Decimal(14, 6)
  notes       String?
  subtotal    Decimal             @default(0) @db.Decimal(14, 2)
  vatTotal    Decimal             @default(0) @db.Decimal(14, 2)
  total       Decimal             @default(0) @db.Decimal(14, 2)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  issuedAt    DateTime?
  lines       BillingInvoiceLine[]
  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

/// Ligne détaillée d'un brouillon, montants calculés côté serveur.
model BillingInvoiceLine {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position        Int
  description     String
  quantity        Decimal        @db.Decimal(12, 3)
  unitPrice       Decimal        @db.Decimal(14, 2)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  vatRate         Decimal        @default(0) @db.Decimal(5, 2)
  /// Origine de la ligne : « hosting » ou « claude » (importée des coûts, modifiable), « free » (ligne libre).
  source          String?
  /// Montant d'origine en dollars d'une ligne importée des coûts : la ligne se recalcule quand le taux change (v0.23.0).
  usdAmount       Decimal?       @db.Decimal(14, 4)
  subtotal        Decimal        @db.Decimal(14, 2)
  vatAmount       Decimal        @db.Decimal(14, 2)
  total           Decimal        @db.Decimal(14, 2)
  @@index([invoiceId, position])
}

/// Objectif de la semaine (page d'accueil NJMDev, v0.36.0). Un objectif non validé
/// est reporté sur la semaine suivante : il reste rattaché à sa semaine de création
/// (`weekStart`, lundi 00:00 UTC) et apparaît dans chaque semaine jusqu'à sa validation.
model Objective {
  id        String    @id @default(cuid())
  title     String
  weekStart DateTime
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([weekStart])
}

/// Dossier de prestation (v0.42.0) : à partir d'une seule saisie, produit la demande de règlement
/// et la convention de constatation des travaux (PDF et Word). Ce n'est pas une facture : aucun numéro fiscal.
model BillingServiceDoc {
  id                 String        @id @default(cuid())
  clientId           String
  client             BillingClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  reference          String        @default("")
  appName            String
  description        String        @default("")
  features           String[]      @default([])
  technologies       String        @default("")
  workNature         String        @default("")
  period             String        @default("")
  deliveryState      String        @default("")
  location           String        @default("")
  amount             Decimal?      @db.Decimal(14, 2)
  currency           String        @default("EUR")
  paymentTerms       String        @default("")
  paymentDue         String        @default("")
  paymentCoordinates String        @default("")
  clientLegalForm    String        @default("")
  clientRepresentative String      @default("")
  clientRole         String        @default("")
  place              String        @default("")
  /// Date d'émission de la demande (AAAA-MM-JJ) ; vide = date du jour au moment du téléchargement.
  emissionDate       String?
  /// Composants et coûts détaillés [{description, quantity, unitPrice}] (importés des coûts des applis ou saisis), v0.45.0.
  lines              Json          @default("[]")
  /// Clauses de la convention (loi, juridiction, licence ou cession, pénalités…), v0.47.0.
  terms              Json          @default("{}")
  signRequests       BillingSignRequest[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  @@index([clientId])
}

/// Demande de signature électronique (v0.48.0) : le document est figé (PDF + empreinte SHA-256) à la création.
/// Signature « simple » : lien personnel + code transmis à part, journal de preuve, page de certificat.
model BillingSignRequest {
  id           String            @id @default(cuid())
  serviceDocId String
  serviceDoc   BillingServiceDoc @relation(fields: [serviceDocId], references: [id], onDelete: Restrict)
  /// demande | convention
  kind         String
  title        String
  /// pending | completed | cancelled
  status       String            @default("pending")
  pdf          Bytes
  pdfSha256    String
  /// Emplacements des cadres de signature dans le PDF [{role, page, x, y, w, h}] : la signature y est posée à la finalisation.
  boxes        Json              @default("[]")
  signedPdf    Bytes?
  signedSha256 String?
  createdAt    DateTime          @default(now())
  expiresAt    DateTime
  completedAt  DateTime?
  signers      BillingSigner[]
  @@index([serviceDocId])
}

model BillingSigner {
  id          String             @id @default(cuid())
  requestId   String
  request     BillingSignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// prestataire | client
  role        String
  name        String
  /// Empreintes SHA-256 du jeton du lien et du code : jamais stockés en clair.
  tokenHash   String             @unique
  codeHash    String
  attempts    Int                @default(0)
  /// pending | signed
  status      String             @default("pending")
  viewedAt    DateTime?
  signedAt    DateTime?
  /// Traces techniques conservées comme preuve ; jamais affichées sur les documents (v0.48.2).
  ip          String?
  userAgent   String?
  typedName   String?
  signature   Bytes?
  @@index([requestId])
}
