# Copier en .env pour le développement local. Aucune valeur réelle ici.
DATABASE_URL=postgresql://supervision:supervision@localhost:5432/supervision
JWT_SECRET=a-remplacer
CORS_ORIGIN=http://localhost:5173

# Super administrateur, créé au premier démarrage seulement.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notifications push (alertes sur le téléphone). Facultatif.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Actions Render (redémarrer, redéployer). Facultatif.
RENDER_API_KEY=

# Par appli (MGA, SITE_AUTONOVA, YIRI, MY_FAMILY, PROCEDIA), voir docs/integration.md :
# <APPLI>_URLS            adresses surveillées (remplace les valeurs par défaut)
# <APPLI>_INGEST_TOKEN    jeton que l'appli utilise pour envoyer ses journaux
# <APPLI>_ADMIN_URL       adresse des actions d'administration de l'appli
# <APPLI>_ADMIN_TOKEN     jeton pour appeler ces actions
# <APPLI>_RENDER_SERVICES identifiants des services Render (srv-...), séparés par des virgules
